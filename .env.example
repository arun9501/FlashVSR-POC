# FlashVSR official repo root (e.g. /opt/flashvsr/FlashVSR or third_party/FlashVSR)
FLASHVSR_REPO_PATH=

# Optional: model weights root. If set, must contain FlashVSR/ and FlashVSR-v1.1/ subdirs.
# If unset, weights are expected at {FLASHVSR_REPO_PATH}/examples/WanVSR/FlashVSR(-v1.1)
# FLASHVSR_MODEL_ROOT=

# Defaults (override via CLI if needed)
FLASHVSR_DEFAULT_MODEL_VERSION=v1.1
FLASHVSR_DEFAULT_MODE=tiny_long_video

# FFmpeg binaries (default: ffmpeg / ffprobe from PATH)
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe

# Logging
LOG_LEVEL=INFO

# Optional working/temp dirs
# WORK_DIR=
# TEMP_DIR=

# Optional: Python interpreter for FlashVSR (e.g. venv inside FlashVSR repo)
# FLASHVSR_PYTHON=/opt/flashvsr/FlashVSR/.venv/bin/python
